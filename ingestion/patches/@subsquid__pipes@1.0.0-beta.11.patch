+import { Validator } from '@subsquid/util-internal-validation';
+import { type Hex, type PortalQuery, type Select, type Selected, type Selector, type Simplify, type Trues } from './common.js';
+export type BlockHeaderFields = {
+    number: number;
+    hash: Hex;
+    parentHash: Hex;
+    round: number;
+    parentRound: number;
+    proposer: Hex;
+    timestamp: number;
+    hardfork: {
+        version: number;
+        round: number;
+    } | null;
+};
+export type ActionStatus = 'ok' | 'err';
+export type ActionFields = {
+    actionIndex: number;
+    user: Hex;
+    /** The action as the user signed it. Raw JSON passthrough; its other keys depend on `type`. */
+    action: {
+        type: string;
+        [key: string]: unknown;
+    };
+    signature: {
+        r: Hex;
+        s: Hex;
+        v: number;
+    };
+    nonce: number | null;
+    vaultAddress: Hex | null;
+    status: ActionStatus;
+    /** Raw JSON passthrough. Usually an object, but a plain string on some errors. */
+    response: unknown;
+};
+export type BlockHeaderFieldSelection = Selector<keyof BlockHeaderFields>;
+export type BlockHeader<F extends BlockHeaderFieldSelection = Trues<BlockHeaderFieldSelection>> = Select<BlockHeaderFields, F>;
+export type ActionFieldSelection = Selector<keyof ActionFields>;
+export type Action<F extends ActionFieldSelection = Trues<ActionFieldSelection>> = Select<ActionFields, F>;
+export type FieldSelection = {
+    block?: BlockHeaderFieldSelection;
+    action?: ActionFieldSelection;
+};
+export type DataRequest = {
+    includeAllBlocks?: boolean;
+    actions?: ActionRequest[];
+    orderActions?: OrderActionRequest[];
+    cancelActions?: CancelActionRequest[];
+    cancelByCloidActions?: CancelByCloidActionRequest[];
+    batchModifyActions?: BatchModifyActionRequest[];
+};
+export type ActionRequest = {
+    actionType?: string[];
+    user?: Hex[];
+    vaultAddress?: Hex[];
+    status?: ActionStatus;
+};
+/** `containsAsset` takes asset numbers, not coin names. */
+export type OrderActionRequest = {
+    containsAsset?: number[];
+    containsCloid?: Hex[];
+    user?: Hex[];
+    vaultAddress?: Hex[];
+    status?: ActionStatus;
+};
+export type CancelActionRequest = Omit<OrderActionRequest, 'containsCloid'>;
+export type CancelByCloidActionRequest = OrderActionRequest;
+export type BatchModifyActionRequest = OrderActionRequest;
+export type Query<F extends FieldSelection = FieldSelection> = Simplify<PortalQuery & {
+    type: 'hyperliquidReplicaCmds';
+    fields: F;
+} & DataRequest>;
+export type Block<F extends FieldSelection> = Simplify<{
+    header: BlockHeader<Selected<F, 'block'>>;
+    actions: Action<Selected<F, 'action'>>[];
+}>;
+export declare function getBlockSchema<F extends FieldSelection>(fields: F): Validator<Block<F>, unknown>;
