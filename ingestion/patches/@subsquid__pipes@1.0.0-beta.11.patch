+import {
+  ANY,
+  ANY_OBJECT,
+  BYTES,
+  NAT,
+  array,
+  constant,
+  nullable,
+  object,
+  oneOf,
+  withDefault
+} from "@subsquid/util-internal-validation";
+import {
+  project
+} from "./common.js";
+function getBlockSchema(fields) {
+  let header = object(project(BlockHeaderShape, fields.block));
+  let action = object(project(ActionShape, fields.action));
+  return object({
+    header,
+    actions: withDefault([], array(action))
+  });
+}
+const BlockHeaderShape = {
+  number: NAT,
+  hash: BYTES,
+  parentHash: BYTES,
+  round: NAT,
+  parentRound: NAT,
+  proposer: BYTES,
+  timestamp: NAT,
+  hardfork: nullable(ANY_OBJECT)
+};
+const ActionShape = {
+  actionIndex: NAT,
+  user: BYTES,
+  action: ANY_OBJECT,
+  signature: ANY_OBJECT,
+  nonce: nullable(NAT),
+  vaultAddress: nullable(BYTES),
+  status: oneOf({
+    ok: constant("ok"),
+    err: constant("err")
+  }),
+  response: ANY
+};
+export {
+  getBlockSchema
+};
