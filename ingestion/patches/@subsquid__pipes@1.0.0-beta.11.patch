+import { cast } from "@subsquid/util-internal-validation";
+import { progressTracker } from "../core/progress-tracker.js";
+import {
+  PortalStream,
+  createTransformer,
+  mergeOutputs
+} from "../core/index.js";
+import { getBlockSchema } from "../portal-client/index.js";
+import { HyperliquidReplicaCmdsQueryBuilder } from "./hyperliquid-replica-cmds-query-builder.js";
+import * as replicaCmdsApi from "../portal-client/query/hyperliquid-replica-cmds.js";
+function hyperliquidReplicaCmdsPortalStream({
+  id,
+  portal,
+  outputs,
+  cache,
+  logger,
+  metrics,
+  profiler,
+  progress
+}) {
+  const query = new HyperliquidReplicaCmdsQueryBuilder().addFields({
+    block: { hash: true, number: true }
+  });
+  return new PortalStream({
+    id,
+    portal,
+    query,
+    cache,
+    logger,
+    metrics,
+    profiler,
+    transformers: [
+      progressTracker({
+        interval: progress?.interval,
+        onStart: progress?.onStart,
+        onProgress: progress?.onProgress
+      }),
+      createTransformer({
+        profiler: { name: "normalize data" },
+        transform: (data, ctx) => {
+          const schema = getBlockSchema(ctx.stream.query.raw);
+          return data.map((b) => cast(schema, b));
+        }
+      }),
+      mergeOutputs(outputs)
+    ]
+  });
+}
+export {
+  hyperliquidReplicaCmdsPortalStream,
+  replicaCmdsApi
+};
