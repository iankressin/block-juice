+import { MetricsServer } from "../core/metrics-server.js";
+import { ProgressTrackerOptions } from "../core/progress-tracker.js";
+import * as hl from "../portal-client/query/hyperliquid-replica-cmds.js";
+import { LogLevel, Logger, Outputs, PortalCache, PortalStream, SpanHooks, Transformer } from '../core/index.js';
+import { PortalClientOptions } from '../portal-client/index.js';
+import { HyperliquidReplicaCmdsPortalData, HyperliquidReplicaCmdsQueryBuilder } from './hyperliquid-replica-cmds-query-builder.js';
+export type HyperliquidReplicaCmdsFieldSelection = hl.FieldSelection;
+export * as replicaCmdsApi from '../portal-client/query/hyperliquid-replica-cmds.js';
+export type HyperliquidReplicaCmdsOutputs = Outputs<hl.FieldSelection, HyperliquidReplicaCmdsQueryBuilder<any>>;
+type HyperliquidReplicaCmdsPortalStream<T extends HyperliquidReplicaCmdsOutputs> = T extends HyperliquidReplicaCmdsQueryBuilder<infer Q> ? HyperliquidReplicaCmdsPortalData<Q> : T extends Transformer<any, infer O> ? O : T extends Record<string, Transformer<any, any> | HyperliquidReplicaCmdsQueryBuilder<any>> ? {
+    [K in keyof T]: T[K] extends Transformer<any, infer O> ? O : T[K] extends HyperliquidReplicaCmdsQueryBuilder<infer Q> ? HyperliquidReplicaCmdsPortalData<Q> : never;
+} : never;
+export declare function hyperliquidReplicaCmdsPortalStream<Out extends HyperliquidReplicaCmdsOutputs>({ id, portal, outputs, cache, logger, metrics, profiler, progress, }: {
+    /**
+     * Globally unique, stable identifier for this pipe.
+     * Targets use it as a cursor key to persist progress — two pipes with the
+     * same `id` will share (and overwrite) each other's cursor.
+     */
+    id: string;
+    portal: string | PortalClientOptions;
+    outputs: Out;
+    cache?: PortalCache;
+    metrics?: MetricsServer;
+    logger?: Logger | LogLevel;
+    profiler?: boolean | SpanHooks;
+    progress?: ProgressTrackerOptions;
+}): PortalStream<HyperliquidReplicaCmdsQueryBuilder<{
+    block: {
+        hash: true;
+        number: true;
+    };
+}>, HyperliquidReplicaCmdsPortalStream<Out>>;
