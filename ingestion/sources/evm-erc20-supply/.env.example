# Settings every chain shares. Each chain's own settings, PORTAL_URL, EVM_RPC_URL and START_DATE, are in
# chains/<chain>/.env.example, and a chain's .env next to it overrides them. chains/<chain>/addresses.json
# lists the tokens whose supply to read.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# A Portal API key, sent with every Portal request. Leave it empty to read the public Portal without
# one, at its anonymous limits. The repo-root .env, which bj and Dagster load, is the place for it.
PORTAL_API_KEY=
# Most calls per JSON-RPC batch. Public RPCs refuse large batches.
RPC_BATCH_SIZE=10
# Most requests in flight at once. Public RPCs answer 429 or time out above a few.
RPC_MAX_CONCURRENCY=2

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
