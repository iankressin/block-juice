WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# Lighter's exchange API, which needs no key. The source reads orderBookDetails once a run, only to find
# the market ids of the symbols in addresses.json.
LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai
# Requests a minute. The Lighter API sources share 60 a minute per IP, so keep their sum at or below 60. Past 60 Lighter blocks the address for a minute.
LIGHTER_REQUESTS_PER_MINUTE=15
# Lighter's public S3 bucket, which needs no key. Each UTC day is one file of about 200 MB, which appears
# about 07:03 UTC the next day.
LIGHTER_S3_URL=https://aws-public-blockchain.s3.amazonaws.com
LIGHTER_S3_PREFIX=v1.1/lighter/core/mainnet
# The first UTC day to load, as an ISO date. Lighter's files start on 2025-01-17.
START_DATE=2026-11-14
# The last UTC day to load. Leave it unset to load up to yesterday.
# END_DATE=2026-11-16

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
