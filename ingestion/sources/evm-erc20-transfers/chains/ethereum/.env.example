# The Portal dataset to stream from.
PORTAL_URL=https://portal.sqd.dev/datasets/ethereum-mainnet
# Where the first run starts; later runs resume after the cursor in raw._sync. This is the first
# block at or after 2026-10-16 00:00 UTC, where ticket #48's window on the MEXC-labelled wallets starts.
# The first three wallets see about 32,000 transfers a day and the 23 MEXC wallets about 19,500, so an
# earlier block means many more rows. USDT, the oldest token here, was deployed at block 4634748.
START_BLOCK=26201365
# The last block to read, set only to check a short window. Leave it unset to read to Portal's finalized head.
# END_BLOCK=
