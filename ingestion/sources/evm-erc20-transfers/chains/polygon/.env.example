# The Portal dataset to stream from.
PORTAL_URL=https://portal.sqd.dev/datasets/polygon-mainnet
# Where the first run starts; later runs resume after the cursor in raw._sync. This is the first
# block of 2026-08-10 UTC. pUSD, the newer token here, was deployed at block 84902320. The wallet in
# addresses.json had 983,219 transfers in the 92 days from this block, nearly all of them pUSD paid for
# a Polymarket fill or paid out by a redemption.
START_BLOCK=91743315
# The last block to read, set only to check a short window. Leave it unset to read to Portal's finalized head.
# END_BLOCK=
