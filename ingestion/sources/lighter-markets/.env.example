WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# Lighter's exchange API, which needs no key.
LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai
# Requests a minute, at most 60. Past 60 Lighter blocks the address for a minute.
LIGHTER_REQUESTS_PER_MINUTE=15

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
