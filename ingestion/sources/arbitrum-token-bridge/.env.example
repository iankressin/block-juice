WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# The Portal dataset to stream from.
PORTAL_URL=https://portal.sqd.dev/datasets/arbitrum-one
# A Portal API key, sent with every Portal request. Leave it empty to read the public Portal without
# one, at its anonymous limits. The repo-root .env, which bj and Dagster load, is the place for it.
PORTAL_API_KEY=
# Where the first run starts; later runs resume after the cursor in raw._sync. This is the first block
# of 2026-10-01 UTC. In October 2026 the gateways emitted 809 withdrawals of every token and 161
# deposits of UNI.
START_BLOCK=510496864

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info

# How many blocks one stream-source run reads. A positive whole number caps the run; unset means no cap.
# The cap only affects stream sources, but an invalid value fails any run, including call sources.
# MAX_BLOCKS_PER_RUN=
