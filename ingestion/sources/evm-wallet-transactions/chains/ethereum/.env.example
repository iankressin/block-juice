# The Portal dataset to stream from.
PORTAL_URL=https://portal.sqd.dev/datasets/ethereum-mainnet
# Where the first run starts; later runs resume after the cursor in raw._sync. This is the first block
# at or after 2026-10-16 00:00 UTC, where ticket #48's window on the 23 MEXC-labelled wallets starts.
# addresses.json lists the 608 FBI-attributed Binance hack addresses (ticket #41), which see a few
# hundred transactions a day, mostly dust, then those 23 wallets, which see about 2,300 a day.
START_BLOCK=26201365
# The last block to read, set only to check a short window. Leave it unset to read to Portal's finalized head.
# END_BLOCK=
