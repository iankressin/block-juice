# addresses.json lists the tokens, in Base58Check as TronScan writes them.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

PORTAL_URL=https://portal.sqd.dev/datasets/tron-mainnet
# A Portal API key, sent with every Portal request. Leave it empty to read the public Portal without
# one, at its anonymous limits. The repo-root .env, which bj and Dagster load, is the place for it.
PORTAL_API_KEY=
# The first block at or after 2026-10-08 00:00:00Z, found from Portal's headers: 86914949 is at
# 23:59:57 and 86914950 at 00:00:00. Portal's timestamps route answers 86914493, 23 minutes early.
# Later runs resume after the cursor Pipes keeps.
START_BLOCK=86914950
# The last block to read, set only to check a short window. Leave it empty to read to Portal's
# finalized head.
END_BLOCK=

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
