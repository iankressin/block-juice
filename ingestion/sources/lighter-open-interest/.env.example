WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# Lighter's public S3 bucket, which needs no key. Each UTC day is one file, which appears about 07:03 UTC the next day.
LIGHTER_S3_URL=https://aws-public-blockchain.s3.amazonaws.com
LIGHTER_S3_PREFIX=v1.1/lighter/core/mainnet
# The first UTC day to load, as an ISO date. Lighter's files start on 2025-01-17.
START_DATE=2026-11-14
# The last UTC day to load. Leave it unset to load up to yesterday.
# END_DATE=2026-11-16

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
