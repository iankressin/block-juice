WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# Polymarket's Gamma API, which needs no key.
GAMMA_API_URL=https://gamma-api.polymarket.com
# Markets per page, at most 100.
GAMMA_PAGE_SIZE=100
# Walks that run at once, at most 20. A round sends one request per walk and starts at most once a second,
# so Gamma sees at most this many requests a second against its 300 per 10 seconds.
GAMMA_MAX_CONCURRENCY=6
# An ISO date. Initial closed-market backfill starts here; every run also refreshes open and recent markets.
GAMMA_END_DATE_FROM=2026-10-01

# Optional history policy (defaults shown). See docs/ingestion-performance.md.
# Recent overlap, plus a periodic full sweep to pick up old corrections.
# HISTORY_OVERLAP_DAYS=3
# HISTORY_REFRESH_DAYS=7
# Set to 1 for one run to force a full correction sweep, then unset it.
# HISTORY_FULL_REFRESH=0

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
