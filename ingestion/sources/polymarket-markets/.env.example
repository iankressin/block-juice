WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# Polymarket's Gamma API, which needs no key.
GAMMA_API_URL=https://gamma-api.polymarket.com
# Markets per page, at most 100.
GAMMA_PAGE_SIZE=100
# Walks that run at once, at most 20. Each sends about one request a second, and Gamma allows 300 requests per 10 seconds.
GAMMA_MAX_CONCURRENCY=6
# An ISO date. A run walks the markets that closed on each UTC day from then to today, plus every open market.
GAMMA_END_DATE_FROM=2026-10-01

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
