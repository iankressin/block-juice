WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# The Portal dataset to stream from.
PORTAL_URL=https://portal.sqd.dev/datasets/solana-mainnet
# A Portal API key, sent with every Portal request. Leave it empty to read the public Portal without
# one, at its anonymous limits. The repo-root .env, which bj and Dagster load, is the place for it.
PORTAL_API_KEY=
# The first slot to read. It is named START_BLOCK because `bj coverage` reads it. Later runs resume
# after the cursor in raw._sync. This is the first slot of 2026-10-08 UTC: its header time is
# 2026-10-08T00:00:00Z and the slot before it, 454377022, is at 23:59:59, in Portal and over RPC.
# Portal's timestamp route answers 454628475 for that midnight, 18.7 hours late.
START_BLOCK=454377023
# The last slot to read, set only to check a short window. Leave it empty to read to the finalized head.
# It must be a slot with a block: a run refuses a skipped one.
END_BLOCK=

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
