WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# Lighter's Explorer, which needs no key.
LIGHTER_EXPLORER_URL=https://explorer.elliot.ai
# Request weight a minute, at most 45. The Explorer allows 45 a minute per IP, which lighter-batches (25),
# lighter-account-logs (15) and lighter-tx-stats (5) share. A page of an account's log weighs 4 and a
# logs/{hash} lookup 1. A run alone may take 45.
LIGHTER_EXPLORER_WEIGHT_PER_MINUTE=15
# Lighter's exchange API, which needs no key. The source calls it only to find the accounts of each L1
# address in addresses.json.
LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai
# Requests a minute. The Lighter API sources share 60 a minute per IP, so keep their sum at or below 60.
LIGHTER_REQUESTS_PER_MINUTE=15
# An ISO date or datetime, in UTC unless it carries an offset. The first run reads each account's log back
# to it. The Explorer holds no entry before 2025-08-25.
START_TIME=2026-11-16T00:00:00Z
# Each later run reads back to the newest entry the last run saw, less this many days.
HISTORY_OVERLAP_DAYS=1
# Entries a page, at most 100.
LIGHTER_LOG_PAGE_SIZE=100

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
