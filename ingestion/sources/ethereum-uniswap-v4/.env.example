WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# The Portal dataset to stream from.
PORTAL_URL=https://portal.sqd.dev/datasets/ethereum-mainnet
# A Portal API key, sent with every Portal request. Leave it empty to read the public Portal without
# one, at its anonymous limits. The repo-root .env, which bj and Dagster load, is the place for it.
PORTAL_API_KEY=
# The first block of pool creations. The source must see every pool of the tokens in addresses.json,
# including those created long before START_BLOCK, since they still trade. 21688329 is the PoolManager's
# deploy block, so no v4 pool is older; it is also the default. The first runs, about a million blocks
# each, read pool creations only, until they reach START_BLOCK.
POOLS_START_BLOCK=21688329
# The first block of Swaps: the first block of 2026-10-01 UTC, from "Time window used for checks" in
# catalog/protocols/uniswap/NOTES.md. Later runs resume after the cursor in raw._sync.
START_BLOCK=26093738
# The last block to read. Set it only to check a short window; runs read to Portal's finalized head.
# END_BLOCK=
# Where the ids of the pools found so far are kept, relative to this package. It holds what
# the runs before the cursor learned, so it goes with the cursor: delete it whenever you reset the
# source (raw._sync row and raw table), and never on its own. A run that resumes with a new file fails.
FACTORY_DB=factory.sqlite

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
