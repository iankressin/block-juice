WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# Lighter's Explorer, which needs no key.
LIGHTER_EXPLORER_URL=https://explorer.elliot.ai
# Request weight a minute, at most 45. The Explorer allows 45 a minute per IP, which lighter-batches (25),
# lighter-account-logs (15) and lighter-tx-stats (5) share. A batch read weighs 1. A run alone may take 45.
LIGHTER_EXPLORER_WEIGHT_PER_MINUTE=25
# An ISO date or datetime, in UTC unless it carries an offset. The first run starts at the batch that holds it,
# then each run reads from the first batch not yet final. About 830 batches close a day. It may not come before
# 2025-08-28: batches before 29654 carry no L1 status and never settle. Each day from it to now costs the first
# run about 33 minutes at 25 weight a minute and about 125 MB of JSON, so a START_TIME a month back takes about
# 17 hours. On a new checkout, set it near today.
START_TIME=2026-11-16T00:00:00Z

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
