# Needs an archive node for ALSO_AT_BLOCKS or a past BLOCK_NUMBER. eRPC serves Ethereum from
# infra/erpc/erpc.yaml; without it, set EVM_RPC_URL in chains/ethereum/.env to an archive RPC.
# Empty uses the local eRPC URL derived from root ERPC_PORT and CHAIN. Set a URL to override.
EVM_RPC_URL=
# addresses.json lists the 608 Ethereum addresses the FBI attributes to the 2026-10-29 Binance hack
# (ticket #41). Each run also reads them at block 26294680, the first block at or after 2026-10-29
# 00:00 UTC, so an address that had code before the window shows up even after it lost it.
ALSO_AT_BLOCKS=26294680
