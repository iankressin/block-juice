WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# The Portal dataset to stream from. The public Portal needs no key.
PORTAL_URL=https://portal.sqd.dev/datasets/ethereum-mainnet
# Where the first run starts; later runs resume after the cursor in raw._sync. This is the first
# block of 2026-11-01 UTC. These wallets see about 32,000 transfers a day, so an earlier block
# means many more rows. USDT, the oldest token here, was deployed at block 4634748.
START_BLOCK=26316189

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
