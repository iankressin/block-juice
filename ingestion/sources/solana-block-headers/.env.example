WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# The Portal dataset whose day boundaries to find.
PORTAL_URL=https://portal.sqd.dev/datasets/solana-mainnet
# A Portal API key, sent with every Portal request. Leave it empty to read the public Portal without
# one, at its anonymous limits. The repo-root .env, which bj and Dagster load, is the place for it.
PORTAL_API_KEY=
# The RPC that states the same headers. getBlock must serve slots as old as START_DATE: the public
# RPC served a month-old slot on 2026-11-07.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# The least time between two RPC calls. The public RPC refuses the tail of a burst; 2s apart drains it.
SOLANA_RPC_INTERVAL_MS=2000
# The first UTC midnight to read. Each run reads every midnight from it to END_DATE, or to the last
# midnight Portal has finalized, at most 1,000 a run.
START_DATE=2026-10-08
END_DATE=

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
