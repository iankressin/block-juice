WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

PORTAL_URL=https://portal.sqd.dev/datasets/tron-mainnet
# A Portal API key, sent with every Portal request. Leave it empty to read the public Portal without
# one, at its anonymous limits. The repo-root .env, which bj and Dagster load, is the place for it.
PORTAL_API_KEY=
# TRON's HTTP API, read for the same headers as a second origin.
TRON_HTTP_URL=https://api.trongrid.io
# A TronGrid API key, sent as TRON-PRO-API-KEY. Leave it empty to read TronGrid at its anonymous
# limits.
TRON_API_KEY=
# The least time between two TRON HTTP requests, in milliseconds.
TRON_HTTP_INTERVAL_MS=1000
# Each run calls every UTC midnight from START_DATE, up to END_DATE or the last midnight Portal's
# finalized head has passed, whichever is earlier.
START_DATE=2026-10-08
END_DATE=

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
