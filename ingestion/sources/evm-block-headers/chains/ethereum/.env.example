# The Portal dataset whose headers to read.
PORTAL_URL=https://portal.sqd.dev/datasets/ethereum-mainnet
# eRPC serves Ethereum from infra/erpc/erpc.yaml. Without eRPC, set EVM_RPC_URL in chains/ethereum/.env
# to a public RPC such as https://eth.drpc.org, whose free plan allows 3 calls per JSON-RPC batch.
EVM_RPC_URL=http://localhost:4000/main/evm/1
# The first UTC day to read, from its midnight. Each run reads every midnight from here to Portal's
# finalized head again, at most 1,000.
START_DATE=2026-10-08
# The last UTC day to read. Unset, runs read to the last midnight Portal's finalized head has passed.
# END_DATE=
