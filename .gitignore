.env
.DS_Store

# ingestion
ingestion/**/node_modules/
# The pools Pipes' factory pattern has found, kept in the folder of each chain a source follows.
ingestion/sources/*/chains/*/factory.sqlite*

# transformation
transformation/target/
transformation/dbt_packages/
transformation/logs/
transformation/.user.yml

# orchestration
orchestration/.venv/
orchestration/.dagster_home/
__pycache__/
*.egg-info/
.pytest_cache/

# answers: git tracks each question's question.yaml; what bj answer and the skill write from it stays local
answers/*
!answers/*/
answers/*/*
!answers/*/question.yaml

# The files a factory run passes between its steps and the model (.github/factory/README.md)
.factory/

# Isolated synthetic demo output.
.demo/
